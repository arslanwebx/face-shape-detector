# The detector and public pages work without secrets. Configure the three
# server-only values as Cloudflare Pages Variables and Secrets for real
# contact-form delivery through Resend.
NEXT_PUBLIC_SITE_URL=https://faceshapedetector.online
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Face Shape Detector <contact@faceshapedetector.online>
CONTACT_TO_EMAIL=contact@faceshapedetector.online

# Prevent telemetry work in production and deployment builds.
NEXT_TELEMETRY_DISABLED=1
